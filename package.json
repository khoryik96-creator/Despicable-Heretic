{
  "name": "light-novel-wiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:manifest": "node scripts/generate-manifest.mjs",
    "generate:reader-data": "node scripts/generate-reader-data.mjs",
    "generate": "npm run generate:manifest && npm run generate:reader-data",
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:canon": "node scripts/validate-canon.mjs",
    "validate:reader": "node --check assets/reader.js",
    "validate": "npm run validate:content && npm run validate:canon && npm run validate:reader",
    "test:reader": "playwright test",
    "check": "npm run validate && npm run lint && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
